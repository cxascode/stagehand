{
  "manifest_version": 3,
  "name": "stagehand",
  "version": "1.0.0",
  "description": "Admin utilities for Genesys Cloud — extra tools for the features you use, like export to CSV.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://apps.mypurecloud.com/*",
    "https://api.mypurecloud.com/*",
    "https://apps.use2.us-gov-pure.cloud/*",
    "https://api.use2.us-gov-pure.cloud/*",
    "https://apps.usw2.pure.cloud/*",
    "https://api.usw2.pure.cloud/*",
    "https://apps.cac1.pure.cloud/*",
    "https://api.cac1.pure.cloud/*",
    "https://apps.sae1.pure.cloud/*",
    "https://api.sae1.pure.cloud/*",
    "https://apps.mxc1.pure.cloud/*",
    "https://api.mxc1.pure.cloud/*",
    "https://apps.mypurecloud.de/*",
    "https://api.mypurecloud.de/*",
    "https://apps.mypurecloud.ie/*",
    "https://api.mypurecloud.ie/*",
    "https://apps.euw2.pure.cloud/*",
    "https://api.euw2.pure.cloud/*",
    "https://apps.euc2.pure.cloud/*",
    "https://api.euc2.pure.cloud/*",
    "https://apps.edee1.eusc-pure.cloud/*",
    "https://api.edee1.eusc-pure.cloud/*",
    "https://apps.mec1.pure.cloud/*",
    "https://api.mec1.pure.cloud/*",
    "https://apps.aps1.pure.cloud/*",
    "https://api.aps1.pure.cloud/*",
    "https://apps.mypurecloud.jp/*",
    "https://api.mypurecloud.jp/*",
    "https://apps.apne2.pure.cloud/*",
    "https://api.apne2.pure.cloud/*",
    "https://apps.apne3.pure.cloud/*",
    "https://api.apne3.pure.cloud/*",
    "https://apps.apse1.pure.cloud/*",
    "https://api.apse1.pure.cloud/*",
    "https://apps.mypurecloud.com.au/*",
    "https://api.mypurecloud.com.au/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://apps.mypurecloud.com/*",
        "https://apps.use2.us-gov-pure.cloud/*",
        "https://apps.usw2.pure.cloud/*",
        "https://apps.cac1.pure.cloud/*",
        "https://apps.sae1.pure.cloud/*",
        "https://apps.mxc1.pure.cloud/*",
        "https://apps.mypurecloud.de/*",
        "https://apps.mypurecloud.ie/*",
        "https://apps.euw2.pure.cloud/*",
        "https://apps.euc2.pure.cloud/*",
        "https://apps.edee1.eusc-pure.cloud/*",
        "https://apps.mec1.pure.cloud/*",
        "https://apps.aps1.pure.cloud/*",
        "https://apps.mypurecloud.jp/*",
        "https://apps.apne2.pure.cloud/*",
        "https://apps.apne3.pure.cloud/*",
        "https://apps.apse1.pure.cloud/*",
        "https://apps.mypurecloud.com.au/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  }
}
